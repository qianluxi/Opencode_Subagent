        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 6 }}>并行只发生在没有依赖的地方</Text>
        <Box style={{ width: 1160, height: 1, background: '#E2E8F0', marginTop: 16 }} />
    </Box>

    <svg width={616} height={430} viewBox='0 0 616 430' style={{ position: 'absolute', left: 54, top: 186 }}>
