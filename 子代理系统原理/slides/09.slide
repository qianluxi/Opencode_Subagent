        <text x='308' y='47' textAnchor='middle' fill='#1E293B' fontSize='16' fontFamily='Microsoft YaHei'>片段 B</text>
        <rect x='410' y='8' width='166' height='64' rx='8' fill='#FFFFFF' stroke='#94A3B8' strokeWidth='1.5' />
