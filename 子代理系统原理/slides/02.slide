<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', padding: '60px 60px', position: 'relative' }}>
    <Box style={{ width: 14, height: 14, border: '2px solid #334155', borderRadius: 3 }} />
    <Text style={{ fontSize: 14, letterSpacing: 3, color: '#334155', fontWeight: 'bold', marginTop: 22 }}>CONTENTS</Text>
    <Text style={{ fontSize: 54, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2, marginTop: 12 }}>目录</Text>
    <Box style={{ width: 1160, height: 1, background: '#E2E8F0', marginTop: 28 }} />

    <Box style={{ flexDirection: 'column', marginTop: 8 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 94, borderBottom: '1px solid #E2E8F0' }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 30, fontWeight: 'bold', color: '#334155', width: 90 }}>01</Text>
            <Text style={{ fontSize: 26, color: '#1E293B', flex: 1 }}>拆得开，才派得动</Text>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>P03</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 94, borderBottom: '1px solid #E2E8F0' }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 30, fontWeight: 'bold', color: '#334155', width: 90 }}>02</Text>
            <Text style={{ fontSize: 26, color: '#1E293B', flex: 1 }}>多，不等于强</Text>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>P07</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 94, borderBottom: '1px solid #E2E8F0' }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 30, fontWeight: 'bold', color: '#334155', width: 90 }}>03</Text>
            <Text style={{ fontSize: 26, color: '#1E293B', flex: 1 }}>它会怎么失败</Text>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>P11</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 94 }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 30, fontWeight: 'bold', color: '#334155', width: 90 }}>04</Text>
            <Text style={{ fontSize: 26, color: '#1E293B', flex: 1 }}>该不该用</Text>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>P15</Text>
        </Box>
    </Box>
</Slide>
